{
  "permissions": {
    "allow": [
      "Bash(node next-jd.mjs)",
      "Bash(node next-jd.mjs --pad)"
    ],
    "deny": [
      "Edit(**/*.mjs)",  "Write(**/*.mjs)",
      "Edit(**/*.ps1)",  "Write(**/*.ps1)",
      "Edit(**/*.cmd)",  "Write(**/*.cmd)",
      "Edit(**/*.bat)",  "Write(**/*.bat)",
      "Edit(**/*.sh)",   "Write(**/*.sh)",
      "Edit(**/.env)",   "Write(**/.env)",
      "Edit(**/.env.*)", "Write(**/.env.*)",
      "Edit(**/.claude/**)",       "Write(**/.claude/**)",
      "Edit(**/config/**)",        "Write(**/config/**)",
      "Edit(**/portals.yml)",      "Write(**/portals.yml)",
      "Edit(**/package.json)",     "Write(**/package.json)",
      "Edit(**/package-lock.json)","Write(**/package-lock.json)",
      "Edit(**/installer/**)",     "Write(**/installer/**)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/.claude/**)",
      "Read(**/google-tokens.json)",
      "Read(**/buffer-token.json)",
      "Read(**/*token*.json)",
      "Read(**/*.pem)"
    ]
  }
}
