# trajecktory environment variables
# Copy this file to .env and fill in your values.
#
#   cp .env.example .env

# ── Other integrations (add your own below) ──────────────────────────────────
# ANTHROPIC_API_KEY=your_anthropic_key_here   # For Claude-based workflows
# OPENAI_API_KEY=your_openai_key_here          # Future OpenAI integration

# Expand Coverage rotates through generated and configured ATS search queries.
# TJK_DISCOVER_QUERIES_PER_RUN=12

# ── Local inference pre-filter (optional) ────────────────────────────────────
# Point these at any OpenAI-compatible endpoint you run yourself (vLLM, Ollama,
# llama.cpp, LM Studio) and spark-prefilter.mjs will score the pending queue
# locally and drop the postings not worth spending a Claude evaluation on.
#
# LEAVE THESE UNSET and nothing changes: the pre-filter exits without reading or
# writing anything, and the batch workflow behaves exactly as it does today.
#
# TJK_SPARK_URL is infrastructure, not scoring policy, which is why it lives here
# and not in config/profile.yml. There is no default host on purpose.
#
# TJK_SPARK_URL=http://your-inference-host:8000
# TJK_SPARK_MODEL=your-served-model-id
#
# The threshold below which a posting is discarded. This is a certified operating
# point of ONE model on ONE rubric, not a preference: validate it against your own
# audited sample before raising it. `spark-prefilter.mjs` draws that sample for you.
# TJK_SPARK_THRESHOLD=2.0
#
# TJK_SPARK_CONCURRENCY=16   # parallel requests; prefill is usually a whole-box
#                            # budget, so raising this past ~16 buys little
# TJK_SPARK_MAXTOK=10000     # completion budget per posting
