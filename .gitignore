# Personal data (user fills these)
cv.md
# User-layer proof points (see AGENTS.md Data Contract); never ship
article-digest.md
# All of data/ is user-layer (real + demo); ship none of it. Demo data is
# regenerated from the seed scripts. Keep the dir via .gitkeep only.
data/*
!data/.gitkeep
data/applications.md
data/pipeline.md
data/scan-history.tsv
data/insights/
reports/*.md
!reports/.gitkeep
output/*
!output/.gitkeep
batch/logs/*
!batch/logs/.gitkeep
# Globbed, not exact names: the batch runner writes timestamped copies alongside
# these (batch-state.backup-<stamp>.tsv), and an exact-name rule lets every one of
# them through. Those copies hold real postings, companies and scores, so a single
# `git add -A` would ship them from a tree that looks clean.
batch/batch-state*.tsv
batch/batch-input*.tsv
# Raw JD text staged for a batch run. Root jds/ is already ignored below; this is
# the same content in the batch working area, and the filenames alone name employers.
batch/jds/
batch/tracker-additions/**/*.tsv
!batch/tracker-additions/.gitkeep
batch/ws-tmp/
# Scanner output + dedup state (regenerated by the scan; like data/scan-history)
batch/scan-candidates.json
batch/seen_urls.txt
# One-off operational orchestrator + ATS-resolver artifacts (session scripts with
# absolute home paths + raw company lists; not product code, must never be committed)
batch/agent-scan-*
batch/resolve-*
batch/verify-resolved.mjs
batch/add10-block.yml
jds/*
!jds/.gitkeep
interview-prep/*
!interview-prep/.gitkeep

# User config and customization (never auto-updated)
config/profile.yml
portals.yml
modes/_profile.md
templates/cv-master.docx
.update-dismissed
.update-lock

# Secrets (never commit — use .env.example as template)
.env
# Read-only updater token (injected into the bundle's .git/config at build time)
installer/.update-token
*.update-token

# Generated
.resolved-prompt-*
node_modules/
bun.lock

# Server logs and backups
dashboard-web/server-out.txt
dashboard-web/server-err.txt
dashboard-web/server.log
logs/
*.bak
*.bak-*
*-pre-update.patch

# OS
.DS_Store
*.mov
*.mp4

# Claude Code local
.claude/settings.local.json
.claude/memory/
dashboard-web/src/dist/

# Installer build artifacts (staged/compiled on a build machine)
installer/payload/
installer/Output/
installer/*.log
installer/Git-for-Windows-installer.exe

# Self-update runtime files (per-install, never committed)
.bundle-version
.trajecktory-custom.patch
# Bundled Playwright Chromium (created by build-bundle.ps1, ~680MB; never tracked)
ms-playwright/

# Local-only scratch / tooling (never ship)
dashboard-web/.claude/
ignore-old_design_audit_files/
# /claude-security scan output dirs at repo root (defense-in-depth; each also
# self-ignores via a nested .gitignore, but do not rely on that surviving)
CLAUDE-SECURITY-*/
# Internal point-in-time audit (references security findings + the owner name)
AUDIT.md
# Pre-archive backups (created by archive-discarded.mjs runs)
data/applications.md.bak-*

# Full-project zip backups (created on demand)
backups/
.backup-*/

# Claude Code runtime lock files
.claude/*.lock

# Follow-up snooze state (runtime, per-user)
data/followup-snooze.json
data/apply-dates.json
data/app-notes.json

# User-layer: locators are verbatim text from the user's master resume (see cv-master.docx).
# The shipped default is cv-template-slots.example.json.
templates/cv-template-slots.json
# User-layer: bullet-group ordinals + baselines derived from the user's master.
# The shipped default is cv-bullet-groups.example.json.
templates/cv-bullet-groups.json

# UI/UX audit working dir — contains PII screenshots, never commit
audit/

# Per-lap spec handed to the coding agent (see AGENTS.md, the Claude/Codex loop).
# Rewritten every lap and meaningless once the lap lands, so it is scratch, not
# history. Keeping it tracked would put a churning file in every diff.
HANDOFF.md

# Test sandboxes that must sit inside the repo. Four suites copy a script into
# their sandbox and run it, and those copies use bare imports that Node resolves
# by walking up for node_modules, which the system temp dir cannot provide. They
# used to mkdtemp straight into the repo root, so a leftover was an untracked
# directory one `git add -A` away from being committed. Contained here instead.
.test-sandboxes/
